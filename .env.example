NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_WOOCOMMERCE_URL=

# Market routing remains disabled until the later immutable-build UAT gate.
YSIM_MARKET_ROUTING_ENABLED=false
# Server-only authentication for Proxy-generated x-ysim-* request headers.
# Generate a random value of at least 32 characters; never expose it as NEXT_PUBLIC_*.
YSIM_MARKET_INTERNAL_TOKEN=

WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

PAYMENT_ENABLED_PROVIDERS=gpay_qr,onepay_card,cash_agent

# GPay
GPAY_ENVIRONMENT=sandbox
GPAY_BASE_URL=https://openapi-sandbox.g-pay.vn/v1
GPAY_TOKEN_PATH=/auth/token

GPAY_CLIENT_ID=
GPAY_CLIENT_SECRET=

GPAY_REQUEST_TIMEOUT_MS=15000
GPAY_TOKEN_REFRESH_BUFFER_SECONDS=120

GPAY_SANDBOX_TEST_API_KEY=



# -------------------------------------------------------------------
# GPay
# -------------------------------------------------------------------

GPAY_ENV=sandbox

# Secret bảo vệ các endpoint kiểm thử kỹ thuật trong sandbox.
# Tạo chuỗi ngẫu nhiên dài tối thiểu 32 byte.
GPAY_SANDBOX_TEST_SECRET=

# API kết nối QR Payment của GPay
GPAY_QR_BASE_URL=

# Thông tin xác thực do GPay cấp
GPAY_QR_MERCHANT_CODE=
GPAY_QR_PASSWORD=
GPAY_QR_STORE_CODE=
GPAY_QR_TERMINAL_ID=
GPAY_QR_ACCOUNT_NAME=YSIM
GPAY_QR_SOURCE_OF_FUND=VIETQR

# Khóa riêng của YSim dùng để ký request.
# File phải là PEM private key và không được commit vào Git.
GPAY_PRIVATE_KEY_PATH=

# X.509 certificate của YSim:
# -----BEGIN CERTIFICATE-----
# Certificate này được khai báo trên GPay Developer Portal.
GPAY_CERTIFICATE_PATH=

# Certificate/public certificate do GPay cung cấp,
# dùng để xác minh response hoặc webhook từ GPay.
GPAY_VERIFY_CERTIFICATE_PATH=

# URL callback/webhook công khai
GPAY_QR_WEBHOOK_URL=
GPAY_QR_RETURN_URL=

# -------------------------------------------------------------------
# OnePay
# -------------------------------------------------------------------

ONEPAY_ENV=sandbox
ONEPAY_PAYMENT_URL=
ONEPAY_QUERY_URL=
ONEPAY_MERCHANT_ID=
ONEPAY_ACCESS_CODE=
ONEPAY_SECURE_SECRET=
ONEPAY_RETURN_URL=
ONEPAY_IPN_URL=

# -------------------------------------------------------------------
# Cash / Agent
# -------------------------------------------------------------------

CASH_PAYMENT_ENABLED=true


# -------------------------------------------------------------------
# GPay Virtual Account / Collection
# -------------------------------------------------------------------

# Bật provider VA trên checkout. Giữ false cho đến khi preflight sandbox PASS.
GPAY_VA_ENABLED=false

# Tài liệu GPay công bố base URL sandbox có hậu tố /v1.
GPAY_VA_BASE_URL=https://openapi-sandbox.g-pay.vn/v1

# Giữ token path cấu hình riêng để tránh ghép nhầm /v1/v1/auth/token.
GPAY_VA_TOKEN_PATH=/auth/token
GPAY_VA_CREATE_PATH=/collection/va/create
GPAY_VA_DETAIL_PATH=/collection/va/detail

# Dùng lại GPAY_CLIENT_ID / GPAY_CLIENT_SECRET,
# GPAY_PRIVATE_KEY_PATH, GPAY_CERTIFICATE_PATH,
# GPAY_VERIFY_CERTIFICATE_PATH.
GPAY_VA_ACCOUNT_NAME=
GPAY_VA_BANK_CODE=BIDV
GPAY_VA_MERCHANT_CODE=
GPAY_VA_WEBHOOK_URL=
GPAY_VA_REQUEST_TIMEOUT_MS=15000
GPAY_VA_TOKEN_REFRESH_BUFFER_SECONDS=120

# F06.1B-1 fast ACK + durable fulfillment
GPAY_FAST_ACK_ENABLED=false
GPAY_RECONCILIATION_SWEEP_PAGES=3
GPAY_RECONCILIATION_SWEEP_PER_PAGE=50
GPAY_RECONCILIATION_SWEEP_LIMIT=20
