# F04.2 delayed GPay reconciliation
# Keep disabled during protected regression.
GPAY_DELAYED_RECONCILIATION_ENABLED=false

# Retry after the webhook response, in seconds.
GPAY_RECONCILIATION_RETRY_DELAYS_SECONDS=5,15,30,60

# Dedicated secret for the manual operator endpoint.
GPAY_RECONCILIATION_SECRET=

# Required safety settings.
GPAY_CALLBACK_RECONCILIATION_MODE=query
GPAY_COMMERCE_AUTOMATION_REQUIRE_QUERY=true
GPAY_COMMERCE_AUTOMATION_MODE=disabled
GPAY_COMMERCE_ALLOWED_ORDER_STATUSES=pending,on-hold,processing,completed

# F04.2.1 commerce application retry after GPay provider is confirmed.
GPAY_COMMERCE_RETRY_DELAYS_SECONDS=1,3,10
