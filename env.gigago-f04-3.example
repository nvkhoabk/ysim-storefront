# F04.3 fulfillment readiness gate.
# disabled: no readiness check before GPay init-order.
# audit: persist readiness result but do not block payment.
# block: reject GPay init-order with FULFILLMENT_MAPPING_INVALID when mapping is not ready.
GIGAGO_READINESS_GATE_MODE=disabled

# Existing protected endpoint secret used by F04.3 scripts.
GIGAGO_TEST_SECRET=replace-with-a-long-random-secret
